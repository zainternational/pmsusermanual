# Dependencies
/node_modules

# Production build
/build

# Docusaurus generated
.docusaurus
.cache-loader

# Environment and secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE / Editor
.idea
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-project
*.sublime-workspace

# Misc
*.log
.cache

# Deploy scripts — NOT tracked.
# This repository is public. The deploy tooling names a live server, its SSH
# user, the path to a private key, and the remote webroot paths. None of that
# belongs in a public repo, so the whole folder stays local. Keep a copy in
# your own backups: git will not.
scripts/

# Key material — never commit, under any name
*.ppk
*.pem
*.key
id_rsa*
*.p12
*.pfx

# Server/deploy config, whatever it ends up being called
deploy-config*.ps1
!scripts/deploy-config.example.ps1
.deploy-tmp/

# Working copies of live site files (they go stale and get uploaded by mistake)
site-index.html
*.bak
*.bak.*
